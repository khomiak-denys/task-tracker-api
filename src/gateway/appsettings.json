{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    },
    "AllowedHosts": "*",
    "CorsOptions": {
        "Name": "",
        "AllowedOrigins": [],
        "AllowedMethods": [],
        "AllowedHeaders": []
    },
    "JwtOptions": {
        "Key": "",
        "Issuer": "",
        "Audience": "",
        "TokenValidityMins": ""
    },
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "users-cluster",
                "RateLimiterPolicy": "public-api",
                "Match": {
                    "Path": "/api/v1/auth/{**catch-all}"
                }
            },
            "users-route": {
                "ClusterId": "users-cluster",
                "RateLimiterPolicy": "public-api",
                "Match": {
                    "Path": "/api/v1/users/{**catch-all}"
                }
            },
            "roles-route": {
                "ClusterId": "users-cluster",
                "RateLimiterPolicy": "public-api",
                "Match": {
                    "Path": "/api/v1/roles/{**catch-all}"
                }
            },
            "tasks-route": {
                "ClusterId": "workspaces-cluster",
                "RateLimiterPolicy": "public-api",
                "Match": {
                    "Path": "/api/v1/tasks/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "users-cluster": {
                "HttpClient": {
                    "DangerousAcceptAnyServerCertificate": true
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7001"
                    }
                }
            },
            "workspaces-cluster": {
                "HttpClient": {
                    "DangerousAcceptAnyServerCertificate": true
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7002"
                    }
                }
            }
        }
    }
}